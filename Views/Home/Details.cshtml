@model ProductResponseDto
@{
    ViewData["Title"] = Model.Name;
    var reviews = ViewBag.Reviews as IEnumerable<ReviewResponseDto> ?? new List<ReviewResponseDto>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a href="/?categoryId=@Model.CategoryId" class="text-decoration-none">@Model.CategoryName</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Product Image Gallery -->
        <div class="col-lg-6">
            <div class="product-gallery-main mb-3">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                }
                else
                {
                    <div class="text-muted d-flex flex-column align-items-center">
                        <i class="bi bi-image fs-1 text-secondary"></i>
                        <span>No image preview available</span>
                    </div>
                }
            </div>
            
            <!-- Trust badges card below image -->
            <div class="card border-0 bg-white p-3 rounded-3 shadow-sm">
                <div class="row text-center g-2">
                    <div class="col-4 border-end">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                        <div class="small fw-semibold mt-1">Verified Vendor</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Quality Assured</div>
                    </div>
                    <div class="col-4 border-end">
                        <i class="bi bi-arrow-repeat text-primary fs-4"></i>
                        <div class="small fw-semibold mt-1">7 Days Return</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Hassle-Free Policy</div>
                    </div>
                    <div class="col-4">
                        <i class="bi bi-truck text-warning fs-4"></i>
                        <div class="small fw-semibold mt-1">Free Delivery</div>
                        <div class="text-muted" style="font-size: 0.75rem;">Orders above ₹500</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Purchase Information -->
        <div class="col-lg-6">
            <!-- Vendor Info Card -->
            <div class="vendor-badge-card d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary text-white p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-shop"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Sold & Shipped by</div>
                        <div class="fw-bold text-dark">@Model.SellerShopName</div>
                    </div>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-check-circle-fill me-1"></i>Verified Seller
                </span>
            </div>

            <h1 class="h2 fw-bold text-dark mb-2">@Model.Name</h1>

            <!-- Ratings and Reviews Bar -->
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="d-flex align-items-center gap-1">
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating))
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-black-50"></i>
                            }
                        }
                    </div>
                    <span class="fw-bold ms-1">@Model.AverageRating.ToString("0.0")</span>
                </div>
                <span class="text-muted small">&bull;</span>
                <a href="#reviews-section" class="text-primary text-decoration-none small fw-medium">
                    @Model.ReviewCount verified reviews
                </a>
                <span class="text-muted small">&bull;</span>
                <span class="badge bg-light text-secondary border">SKU #@Model.Id</span>
            </div>

            <hr class="my-3 opacity-25" />

            <!-- Price -->
            <div class="mb-4">
                <div class="d-flex align-items-baseline gap-2">
                    <span class="display-6 fw-bold text-dark">₹@Model.Price.ToString("N2")</span>
                    <span class="text-muted small">Inclusive of all taxes</span>
                </div>
            </div>

            <!-- Stock Status -->
            <div class="mb-4">
                @if (Model.StockQuantity > 10)
                {
                    <div class="alert alert-success d-inline-flex align-items-center py-2 px-3 small border-0 rounded-pill mb-0">
                        <i class="bi bi-check-circle-fill me-2"></i>In Stock (@Model.StockQuantity available from vendor)
                    </div>
                }
                else if (Model.StockQuantity > 0)
                {
                    <div class="alert alert-warning d-inline-flex align-items-center py-2 px-3 small border-0 rounded-pill mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Hurry, only @Model.StockQuantity left in stock!
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-inline-flex align-items-center py-2 px-3 small border-0 rounded-pill mb-0">
                        <i class="bi bi-x-circle-fill me-2"></i>Currently Out of Stock
                    </div>
                }
            </div>

            <!-- Product Description -->
            <div class="mb-4">
                <h6 class="fw-bold text-uppercase text-muted small">Description & Features</h6>
                <p class="text-secondary leading-relaxed">@Model.Description</p>
            </div>

            <!-- Add to Cart & Wishlist Form Area -->
            @if (Model.StockQuantity > 0)
            {
                <div class="mb-4">
                    <form action="/cart/add" method="post" id="addToCartForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label class="fw-semibold small text-muted">Quantity:</label>
                            <div class="quantity-input-group">
                                <button type="button" class="quantity-btn" onclick="let q = document.getElementById('prod-qty'); if(parseInt(q.value) > 1) q.value = parseInt(q.value)-1;">-</button>
                                <input type="number" id="prod-qty" name="quantity" class="quantity-val" value="1" min="1" max="@Model.StockQuantity" readonly />
                                <button type="button" class="quantity-btn" onclick="let q = document.getElementById('prod-qty'); if(parseInt(q.value) < @Model.StockQuantity) q.value = parseInt(q.value)+1;">+</button>
                            </div>
                        </div>
                    </form>

                    <div class="d-flex gap-3">
                        <button type="submit" form="addToCartForm" class="btn btn-primary-custom flex-grow-1 py-2 fs-6">
                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                        </button>
                        <form action="/wishlist/toggle/@Model.Id" method="post" class="d-inline m-0 wishlist-toggle-form" data-product-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-secondary py-2 px-3 rounded-3 @(ViewBag.IsInWishlist == true ? "text-danger border-danger" : "")" title="@(ViewBag.IsInWishlist == true ? "Saved in Wishlist" : "Add to Wishlist")">
                                <i class="bi @(ViewBag.IsInWishlist == true ? "bi-heart-fill text-danger" : "bi-heart") fs-5"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex gap-3 mb-4">
                    <button class="btn btn-secondary flex-grow-1 py-2" disabled>
                        Out of Stock
                    </button>
                    <form action="/wishlist/toggle/@Model.Id" method="post" class="d-inline m-0 wishlist-toggle-form" data-product-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-secondary py-2 px-3 rounded-3 @(ViewBag.IsInWishlist == true ? "text-danger border-danger" : "")" title="@(ViewBag.IsInWishlist == true ? "Saved in Wishlist" : "Add to Wishlist")">
                            <i class="bi @(ViewBag.IsInWishlist == true ? "bi-heart-fill text-danger" : "bi-heart") fs-5"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Customer Reviews Section -->
    <div id="reviews-section" class="mt-5 pt-4 border-top">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 80px;">
                    <h4 class="fw-bold mb-3">Customer Reviews</h4>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="display-4 fw-bold text-dark">@Model.AverageRating.ToString("0.0")</div>
                        <div>
                            <div class="rating-stars fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.AverageRating))
                                    {
                                        <i class="bi bi-star-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-black-50"></i>
                                    }
                                }
                            </div>
                            <div class="text-muted small">Based on @Model.ReviewCount verified reviews</div>
                        </div>
                    </div>

                    <!-- Post Review Form -->
                    <div class="border-top pt-3">
                        <h6 class="fw-bold mb-3">Write a Verified Review</h6>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Home" asp-action="AddReview" asp-route-id="@Model.Id" method="post">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Your Rating (1 to 5 Stars)</label>
                                    <select name="Rating" class="form-select form-select-sm" required>
                                        <option value="5" selected>5 Stars - Excellent</option>
                                        <option value="4">4 Stars - Very Good</option>
                                        <option value="3">3 Stars - Average</option>
                                        <option value="2">2 Stars - Poor</option>
                                        <option value="1">1 Star - Terrible</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Review Comment</label>
                                    <textarea name="Comment" class="form-control" rows="3" placeholder="Share your experience with this item..." required minlength="3" maxlength="1000"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary-custom w-100 btn-sm">
                                    Submit Review
                                </button>
                                <div class="form-text text-muted small mt-2">
                                    <i class="bi bi-shield-lock me-1"></i>Only verified buyers who ordered and received this item can review it.
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-light border small text-center">
                                <p class="mb-2 text-muted">Please sign in to submit a review.</p>
                                <a href="/account/login" class="btn btn-outline-primary btn-sm rounded-pill px-3">Sign In to Review</a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Review Items List -->
            <div class="col-lg-7">
                <h5 class="fw-bold mb-4">Verified Customer Feedback (@reviews.Count())</h5>
                @if (!reviews.Any())
                {
                    <div class="card border-0 bg-white p-5 text-center rounded-4 shadow-sm">
                        <div class="text-muted mb-2"><i class="bi bi-chat-square-text fs-1"></i></div>
                        <h6>No reviews yet</h6>
                        <p class="text-muted small">Be the first verified customer to share feedback on this product.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in reviews)
                        {
                            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light rounded-circle p-2 text-primary">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold small">@rev.UserName</div>
                                            <div class="badge bg-success-subtle text-success" style="font-size: 0.7rem;">
                                                <i class="bi bi-patch-check-fill me-1"></i>Verified Purchase
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-muted small">@rev.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="rating-stars mb-2 small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rev.Rating)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-black-50"></i>
                                        }
                                    }
                                </div>
                                <p class="text-secondary small m-0 leading-relaxed">@rev.Comment</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
