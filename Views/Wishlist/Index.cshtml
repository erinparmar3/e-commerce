@model IEnumerable<WishlistItemResponseDto>
@{
    ViewData["Title"] = "My Saved Wishlist";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-heart me-2 text-danger"></i>My Saved Wishlist</h2>
            <p class="text-muted small m-0">Keep track of your favorite products from independent sellers</p>
        </div>
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-compass me-1"></i>Explore More
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="text-muted mb-3"><i class="bi bi-heartbreak display-1 text-secondary opacity-50"></i></div>
            <h4 class="fw-bold mb-2">Your Wishlist is Empty</h4>
            <p class="text-muted mb-4">You haven't saved any items yet. Click the heart icon on any product to save it here for later.</p>
            <div>
                <a href="/" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-arrow-left me-1"></i>Discover Products
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="product-card">
                        <!-- Media -->
                        <a href="/product/@item.ProductId" class="card-media text-decoration-none">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProductName" loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                            }
                            else
                            {
                                <div class="text-muted d-flex flex-column align-items-center">
                                    <i class="bi bi-image fs-1 text-secondary"></i>
                                    <span class="small">No image</span>
                                </div>
                            }
                        </a>

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <a href="/product/@item.ProductId" class="product-title mb-2">
                                @item.ProductName
                            </a>

                            <div class="price-tag mb-3">
                                ₹@item.Price.ToString("N2")
                            </div>

                            <div class="mt-auto d-flex flex-column gap-2">
                                <form action="/cart/add" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-primary-custom w-100 btn-sm">
                                        <i class="bi bi-cart-plus me-1"></i>Move to Cart
                                    </button>
                                </form>

                                <form action="/wishlist/remove/@item.ProductId" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                                        <i class="bi bi-trash3 me-1"></i>Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
