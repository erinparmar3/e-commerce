@model CartResponseDto
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-cart3 me-2 text-primary"></i>Shopping Cart</h2>
            <p class="text-muted small m-0">Review items in your multi-vendor cart before proceeding to checkout</p>
        </div>
        @if (Model.Items.Any())
        {
            <form action="/cart/clear" method="post" onsubmit="return confirm('Are you sure you want to clear all items from your cart?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                    <i class="bi bi-trash3 me-1"></i>Clear Entire Cart
                </button>
            </form>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="text-muted mb-3"><i class="bi bi-cart-x display-1"></i></div>
            <h4 class="fw-bold mb-2">Your Shopping Cart is Empty</h4>
            <p class="text-muted mb-4">You don't have any items in your cart yet. Explore our curated multi-vendor catalog to discover great deals.</p>
            <div>
                <a href="/" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-arrow-left me-1"></i>Start Shopping Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light text-uppercase small text-muted">
                                <tr>
                                    <th class="ps-4 py-3" style="min-width: 250px;">Product</th>
                                    <th class="py-3">Price</th>
                                    <th class="py-3 text-center" style="width: 160px;">Quantity</th>
                                    <th class="py-3 text-end">Subtotal</th>
                                    <th class="py-3 text-center pe-4" style="width: 60px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <!-- Product info -->
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div style="width: 64px; height: 64px; border-radius: 8px; overflow: hidden; background: #f1f5f9; flex-shrink: 0;" class="border">
                                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                    {
                                                        <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                                            <i class="bi bi-image"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div>
                                                    <a href="/product/@item.ProductId" class="fw-bold text-dark text-decoration-none d-block">
                                                        @item.ProductName
                                                    </a>
                                                    <span class="small text-muted">SKU: #@item.ProductId</span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Unit Price -->
                                        <td class="py-3 fw-semibold">
                                            ₹@item.Price.ToString("N2")
                                        </td>

                                        <!-- Quantity Controls -->
                                        <td class="py-3 text-center">
                                            <form action="/cart/update" method="post" class="d-inline-flex align-items-center gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2 py-0" title="Decrease">
                                                    -
                                                </button>
                                                <span class="fw-bold px-2">@item.Quantity</span>
                                                <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2 py-0" title="Increase">
                                                    +
                                                </button>
                                            </form>
                                        </td>

                                        <!-- Subtotal -->
                                        <td class="py-3 text-end fw-bold text-dark">
                                            ₹@item.Subtotal.ToString("N2")
                                        </td>

                                        <!-- Remove Item -->
                                        <td class="py-3 text-center pe-4">
                                            <form action="/cart/remove" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0" title="Remove item">
                                                    <i class="bi bi-trash3 fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-3">
                    <a href="/" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Items Subtotal</span>
                        <span class="fw-semibold">₹@Model.Subtotal.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estimated Tax (10%)</span>
                        <span class="fw-semibold">₹@Model.Tax.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Standard Shipping</span>
                        <span class="fw-semibold text-success">FREE</span>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold text-dark">Total Amount</span>
                        <span class="fs-4 fw-bold text-primary">₹@Model.Total.ToString("N2")</span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <a href="/checkout" class="btn btn-primary-custom py-2 fs-6">
                            Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                    <div class="p-3 bg-light rounded-3 text-muted small">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-shield-check text-success"></i>
                            <span>Secure encrypted checkout</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-repeat text-primary"></i>
                            <span>Instant stock reservation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
