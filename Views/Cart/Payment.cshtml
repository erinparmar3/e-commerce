@model Cart
@{
    ViewData["Title"] = "Secure Payment";
    var total = (decimal)ViewBag.Total;
    var shipping = (string)ViewBag.ShippingAddress;
    var itemCount = (int)ViewBag.ItemCount;
}

<style>
    .payment-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: flex-start;
        gap: 2rem;
        padding: 2rem 0;
    }

    /* ── Card form ── */
    .payment-card {
        flex: 1;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 32px rgba(0,0,0,.10);
        padding: 2rem 2.5rem;
    }

    .payment-card h4 {
        font-weight: 700;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .lock-icon { color: #22c55e; }

    /* visual credit card */
    .card-preview {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 60%, #7c3aed 100%);
        border-radius: 14px;
        padding: 1.5rem 1.75rem;
        color: #fff;
        font-family: 'Courier New', monospace;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(37,99,235,.35);
    }

    .card-preview::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 160px; height: 160px;
        border-radius: 50%;
        background: rgba(255,255,255,.07);
    }

    .card-preview::after {
        content: '';
        position: absolute;
        bottom: -50px; left: 60px;
        width: 200px; height: 200px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
    }

    .card-chip {
        width: 40px; height: 30px;
        background: linear-gradient(135deg,#f5c842,#e0a020);
        border-radius: 6px;
        margin-bottom: 1rem;
        display: flex; align-items: center; justify-content: center;
    }

    .card-number-display {
        font-size: 1.25rem;
        letter-spacing: .2em;
        margin-bottom: .75rem;
        font-weight: 600;
    }

    .card-meta { display: flex; justify-content: space-between; font-size: .8rem; opacity: .8; }

    /* form inputs */
    .form-floating .form-control {
        border-radius: 10px;
        border: 1.5px solid #e5e7eb;
        transition: border-color .2s;
    }

    .form-floating .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    /* pay button */
    .btn-pay {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        border: none;
        border-radius: 12px;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: .03em;
        padding: .85rem;
        color: #fff;
        transition: transform .15s, box-shadow .15s, opacity .15s;
        box-shadow: 0 4px 16px rgba(34,197,94,.4);
    }

    .btn-pay:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(34,197,94,.5);
        color: #fff;
    }

    .btn-pay:disabled { opacity: .7; cursor: not-allowed; }

    /* processing overlay */
    .processing-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,.5);
        z-index: 9999;
        align-items: center; justify-content: center;
        flex-direction: column;
        gap: 1rem;
        color: #fff;
        font-size: 1.2rem;
        font-weight: 600;
    }

    .processing-overlay.active { display: flex; }

    .spinner-ring {
        width: 64px; height: 64px;
        border: 5px solid rgba(255,255,255,.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .8s linear infinite;
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ── Order summary sidebar ── */
    .order-summary {
        width: 320px;
        flex-shrink: 0;
        background: #f8fafc;
        border-radius: 16px;
        border: 1.5px solid #e5e7eb;
        padding: 1.5rem;
        position: sticky;
        top: 1rem;
    }

    .order-summary h5 {
        font-weight: 700;
        margin-bottom: 1rem;
        color: #1e293b;
    }

    .summary-item {
        display: flex;
        justify-content: space-between;
        font-size: .9rem;
        padding: .4rem 0;
        border-bottom: 1px solid #f1f5f9;
        color: #475569;
    }

    .summary-item:last-of-type { border-bottom: none; }

    .summary-total {
        display: flex;
        justify-content: space-between;
        font-weight: 800;
        font-size: 1.15rem;
        padding-top: .75rem;
        margin-top: .5rem;
        border-top: 2px solid #e2e8f0;
        color: #0f172a;
    }

    .shipping-badge {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: .6rem .75rem;
        font-size: .82rem;
        color: #166534;
        margin-top: 1rem;
    }

    .secure-badges {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin-top: 1rem;
        justify-content: center;
    }

    .secure-badge {
        display: flex;
        align-items: center;
        gap: .3rem;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: .3rem .6rem;
        font-size: .75rem;
        color: #64748b;
    }

    @@media (max-width: 768px) {
        .payment-wrapper { flex-direction: column-reverse; }
        .order-summary { width: 100%; position: static; }
    }
</style>

<div class="payment-wrapper">

    <!-- ── Left: Payment Form ── -->
    <div class="payment-card">
        <h4>
            <span class="lock-icon">🔒</span> Secure Payment
        </h4>

        <!-- Visual Card Preview -->
        <div class="card-preview" id="cardPreview">
            <div class="card-chip"></div>
            <div class="card-number-display" id="previewNumber">•••• •••• •••• ••••</div>
            <div class="card-meta">
                <div>
                    <div style="font-size:.7rem;opacity:.7;margin-bottom:.15rem">CARD HOLDER</div>
                    <div id="previewName" style="font-weight:600;text-transform:uppercase">YOUR NAME</div>
                </div>
                <div>
                    <div style="font-size:.7rem;opacity:.7;margin-bottom:.15rem">EXPIRES</div>
                    <div id="previewExpiry" style="font-weight:600">MM / YY</div>
                </div>
            </div>
        </div>

        <!-- Payment Form -->
        <form id="paymentForm" asp-controller="Cart" asp-action="ProcessPayment" method="post" onsubmit="submitPayment(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="shippingAddress" value="@shipping" />

            <div class="mb-3 form-floating">
                <input type="text" class="form-control" id="cardName" name="cardName"
                       placeholder="Name on card"
                       oninput="document.getElementById('previewName').textContent = this.value.toUpperCase() || 'YOUR NAME'"
                       required maxlength="30" />
                <label for="cardName">Name on card</label>
            </div>

            <div class="mb-3 form-floating">
                <input type="text" class="form-control" id="cardNumber" name="cardNumber"
                       placeholder="Card number" maxlength="19"
                       oninput="formatCardNumber(this)" required />
                <label for="cardNumber">Card number</label>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-6 form-floating">
                    <input type="text" class="form-control" id="expiry" name="expiry"
                           placeholder="MM / YY" maxlength="7"
                           oninput="formatExpiry(this)" required />
                    <label for="expiry">MM / YY</label>
                </div>
                <div class="col-6 form-floating">
                    <input type="text" class="form-control" id="cvv" name="cvv"
                           placeholder="CVV" maxlength="4"
                           oninput="this.value=this.value.replace(/\D/g,'')" required />
                    <label for="cvv">CVV</label>
                </div>
            </div>

            <button type="submit" class="btn btn-pay w-100" id="payBtn">
                💳 Pay @total.ToString("C")
            </button>

            <div class="secure-badges mt-3">
                <span class="secure-badge">🔒 SSL Encrypted</span>
                <span class="secure-badge">🛡️ Fraud Protected</span>
                <span class="secure-badge">✅ Demo Mode</span>
            </div>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Cart" asp-action="Index" class="text-muted small">← Back to cart</a>
        </div>
    </div>

    <!-- ── Right: Order Summary ── -->
    <div class="order-summary">
        <h5>Order Summary</h5>

        @foreach (var item in Model.CartItems)
        {
            <div class="summary-item">
                <span>
                    @item.Product!.Name
                    <span class="text-muted">× @item.Quantity</span>
                </span>
                <span>@item.LineTotal.ToString("C")</span>
            </div>
        }

        <div class="summary-item">
            <span>Subtotal (@itemCount item@(itemCount == 1 ? "" : "s"))</span>
            <span>@total.ToString("C")</span>
        </div>
        <div class="summary-item">
            <span>Shipping</span>
            <span class="text-success fw-semibold">Free</span>
        </div>

        <div class="summary-total">
            <span>Total</span>
            <span>@total.ToString("C")</span>
        </div>

        <div class="shipping-badge">
            📦 Ship to: @shipping
        </div>
    </div>
</div>

<!-- Processing Overlay -->
<div class="processing-overlay" id="processingOverlay">
    <div class="spinner-ring"></div>
    <div>Processing payment…</div>
    <div style="font-size:.9rem;opacity:.8;font-weight:400">Please don't close this window</div>
</div>

@section Scripts {
<script>
    function formatCardNumber(input) {
        let v = input.value.replace(/\D/g, '').substring(0, 16);
        let formatted = v.match(/.{1,4}/g)?.join(' ') ?? v;
        input.value = formatted;

        // Update card preview
        let display = v.padEnd(16, '•').match(/.{1,4}/g).join(' ');
        document.getElementById('previewNumber').textContent = display;
    }

    function formatExpiry(input) {
        let v = input.value.replace(/\D/g, '').substring(0, 4);
        if (v.length >= 3) v = v.substring(0, 2) + ' / ' + v.substring(2);
        input.value = v;
        document.getElementById('previewExpiry').textContent = v || 'MM / YY';
    }

    function submitPayment(e) {
        e.preventDefault();
        const btn = document.getElementById('payBtn');
        const overlay = document.getElementById('processingOverlay');

        btn.disabled = true;
        btn.textContent = 'Processing…';
        overlay.classList.add('active');

        // Simulate a 2-second payment processing delay, then submit for real.
        setTimeout(() => {
            document.getElementById('paymentForm').submit();
        }, 2000);
    }
</script>
}
