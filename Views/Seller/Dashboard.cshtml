@model IEnumerable<ProductResponseDto>
@{
    ViewData["Title"] = "Seller Portal Dashboard";
    var profile = ViewBag.SellerProfile as SellerProfileDto;
    var orders = ViewBag.Orders as IEnumerable<OrderResponseDto> ?? new List<OrderResponseDto>();

    int totalProducts = Model.Count();
    int lowStockCount = Model.Count(p => p.StockQuantity <= 5);
    int totalOrders = orders.Count();
    decimal totalRevenue = orders.Where(o => o.Status != OrderStatuses.Cancelled).SelectMany(o => o.Items).Sum(i => i.Subtotal);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold m-0"><i class="bi bi-shop me-2 text-primary"></i>@(profile?.ShopName ?? "Seller Portal")</h2>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                    <i class="bi bi-patch-check-fill me-1"></i>Approved Vendor
                </span>
            </div>
            <p class="text-muted small m-0 mt-1">Manage product catalog, inventory stock levels, and order dispatches</p>
        </div>

        <a href="/seller/products/new" class="btn btn-primary-custom">
            <i class="bi bi-plus-circle me-1"></i>Add New Product
        </a>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-wrap metric-blue">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Listed Products</div>
                    <div class="fs-4 fw-bold text-dark">@totalProducts</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-wrap metric-emerald">
                    <i class="bi bi-currency-rupee"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Vendor Sales</div>
                    <div class="fs-4 fw-bold text-dark">₹@totalRevenue.ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-wrap metric-purple">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Total Orders</div>
                    <div class="fs-4 fw-bold text-dark">@totalOrders</div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="metric-card">
                <div class="metric-icon-wrap metric-amber">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-semibold">Low Stock Alert</div>
                    <div class="fs-4 fw-bold text-dark">@lowStockCount</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="sellerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2 fw-semibold" id="products-tab" data-bs-toggle="pill" data-bs-target="#tab-products" type="button" role="tab">
                <i class="bi bi-grid me-2"></i>My Products (@totalProducts)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2 fw-semibold" id="orders-tab" data-bs-toggle="pill" data-bs-target="#tab-orders" type="button" role="tab">
                <i class="bi bi-truck me-2"></i>Customer Orders (@totalOrders)
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="sellerTabContent">
        <!-- Tab 1: Products -->
        <div class="tab-pane fade show active" id="tab-products" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                @if (!Model.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        <h5>No products added yet</h5>
                        <p class="small mb-3">Add your first product to begin selling on ShopNet.</p>
                        <a href="/seller/products/new" class="btn btn-primary-custom btn-sm">Add Product Now</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-4 py-3">Product</th>
                                    <th class="py-3">Category</th>
                                    <th class="py-3">Price</th>
                                    <th class="py-3 text-center">Stock</th>
                                    <th class="py-3 text-center">Rating</th>
                                    <th class="py-3 text-center">Status</th>
                                    <th class="py-3 text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prod in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div style="width: 48px; height: 48px; border-radius: 6px; overflow: hidden; background: #f8fafc; flex-shrink: 0;" class="border">
                                                    @if (!string.IsNullOrEmpty(prod.ImageUrl))
                                                    {
                                                        <img src="@prod.ImageUrl" alt="@prod.Name" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted small"><i class="bi bi-image"></i></div>
                                                    }
                                                </div>
                                                <div>
                                                    <a href="/product/@prod.Id" class="fw-bold text-dark text-decoration-none">
                                                        @prod.Name
                                                    </a>
                                                    <div class="small text-muted">SKU: #@prod.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="badge bg-light text-secondary border">@prod.CategoryName</span>
                                        </td>
                                        <td class="py-3 fw-semibold">
                                            ₹@prod.Price.ToString("N2")
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (prod.StockQuantity <= 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Out of stock (0)</span>
                                            }
                                            else if (prod.StockQuantity <= 5)
                                            {
                                                <span class="badge bg-warning-subtle text-warning">Low: @prod.StockQuantity</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">@prod.StockQuantity units</span>
                                            }
                                        </td>
                                        <td class="py-3 text-center">
                                            <span class="fw-semibold text-warning"><i class="bi bi-star-fill me-1"></i>@prod.AverageRating.ToString("0.0")</span>
                                            <span class="small text-muted">(@prod.ReviewCount)</span>
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (prod.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                        <td class="py-3 text-end pe-4">
                                            <div class="d-inline-flex gap-2">
                                                <a href="/seller/products/edit/@prod.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="DeleteProduct" asp-route-id="@prod.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Tab 2: Orders -->
        <div class="tab-pane fade" id="tab-orders" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                @if (!orders.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-box-arrow-in-down fs-1 d-block mb-2"></i>
                        <h5>No customer orders yet</h5>
                        <p class="small">Orders placed for your products will appear here for fulfillment.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-4 py-3">Order #</th>
                                    <th class="py-3">Customer & Delivery</th>
                                    <th class="py-3">Your Items</th>
                                    <th class="py-3">Current Status</th>
                                    <th class="py-3 text-end pe-4">Update Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ord in orders)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark">#@ord.Id</div>
                                            <div class="small text-muted">@ord.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        </td>
                                        <td class="py-3">
                                            <div class="fw-semibold text-dark">@ord.FullName</div>
                                            <div class="small text-muted">@ord.City, @ord.State</div>
                                            <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@ord.Phone</div>
                                        </td>
                                        <td class="py-3">
                                            @foreach (var item in ord.Items)
                                            {
                                                <div class="small">
                                                    <strong>@item.Quantity&times;</strong> @item.ProductName
                                                    <span class="text-muted">(₹@item.Subtotal.ToString("N2"))</span>
                                                </div>
                                            }
                                        </td>
                                        <td class="py-3">
                                            <span class="badge @(ord.Status == OrderStatuses.Delivered ? "bg-success" : ord.Status == OrderStatuses.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                                @ord.Status
                                            </span>
                                        </td>
                                        <td class="py-3 text-end pe-4">
                                            @if (ord.Status != OrderStatuses.Cancelled && ord.Status != OrderStatuses.Delivered)
                                            {
                                                <form asp-action="UpdateOrderStatus" method="post" class="d-inline-flex align-items-center gap-2">
                                                    <input type="hidden" name="orderId" value="@ord.Id" />
                                                    <select name="status" class="form-select form-select-sm" style="width: 130px;">
                                                        @if (ord.Status == OrderStatuses.Pending)
                                                        {
                                                            <option value="CONFIRMED">Confirm</option>
                                                        }
                                                        @if (ord.Status == OrderStatuses.Pending || ord.Status == OrderStatuses.Confirmed)
                                                        {
                                                            <option value="SHIPPED">Ship</option>
                                                        }
                                                        <option value="DELIVERED">Deliver</option>
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-primary-custom">
                                                        Update
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No action needed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
