@model IEnumerable<AdminUserDto>
@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-people me-2 text-danger"></i>User Directory</h2>
            <p class="text-muted small m-0">View registered platform users, roles, and manage access status</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th class="ps-4 py-3">User</th>
                        <th class="py-3">Role</th>
                        <th class="py-3">Contact</th>
                        <th class="py-3">Joined</th>
                        <th class="py-3 text-center">Status</th>
                        <th class="py-3 text-end pe-4">Access Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="fw-bold text-dark">@u.Name</div>
                                <div class="small text-muted">@u.Email</div>
                            </td>
                            <td class="py-3">
                                <span class="badge @(u.Role == UserRoles.Admin ? "bg-danger" : u.Role == UserRoles.Seller ? "bg-primary" : "bg-success")">
                                    @u.Role
                                </span>
                                @if (!string.IsNullOrEmpty(u.SellerShopName))
                                {
                                    <div class="small text-muted mt-1"><i class="bi bi-shop me-1"></i>@u.SellerShopName</div>
                                }
                            </td>
                            <td class="py-3 text-secondary small">
                                @(string.IsNullOrEmpty(u.Phone) ? "—" : u.Phone)
                            </td>
                            <td class="py-3 text-muted small">
                                @u.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="py-3 text-center">
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">Deactivated</span>
                                }
                            </td>
                            <td class="py-3 text-end pe-4">
                                @if (u.Role != UserRoles.Admin)
                                {
                                    <form asp-action="UpdateUserStatus" asp-route-userId="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@(!u.IsActive)" />
                                        @if (u.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Deactivate this user? They will not be able to sign in.');">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                Activate
                                            </button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
