@model IEnumerable<OrderResponseDto>
@{
    ViewData["Title"] = "Platform Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-box-seam me-2 text-danger"></i>Platform Orders</h2>
            <p class="text-muted small m-0">Cross-vendor marketplace transaction records and fulfillment audit</p>
        </div>
        <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-receipt fs-1 d-block mb-2"></i>
                <h5>No orders placed yet</h5>
                <p class="small">Transactions placed by buyers will show up here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-uppercase text-muted">
                        <tr>
                            <th class="ps-4 py-3">Order ID</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Items Included</th>
                            <th class="py-3 text-end">Total Amount</th>
                            <th class="py-3 text-center">Order Status</th>
                            <th class="py-3 text-center pe-4">Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark font-monospace">#@ord.Id</td>
                                <td class="py-3">
                                    <div class="fw-semibold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted">@ord.City, @ord.State</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@ord.Phone</div>
                                </td>
                                <td class="py-3 text-muted small">
                                    @ord.CreatedAt.ToString("MMM dd, yyyy")
                                    <div class="text-secondary" style="font-size: 0.75rem;">@ord.CreatedAt.ToString("hh:mm tt")</div>
                                </td>
                                <td class="py-3">
                                    @foreach (var item in ord.Items)
                                    {
                                        <div class="small">
                                            <span class="fw-semibold">@item.Quantity &times;</span> @item.ProductName
                                            <span class="text-muted">(@item.SellerShopName)</span>
                                        </div>
                                    }
                                </td>
                                <td class="py-3 text-end fw-bold text-dark fs-6">
                                    ₹@ord.TotalAmount.ToString("N2")
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge @(ord.Status == OrderStatuses.Delivered ? "bg-success" : ord.Status == OrderStatuses.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                        @ord.Status
                                    </span>
                                </td>
                                <td class="py-3 text-center pe-4">
                                    <span class="badge bg-light text-secondary border">
                                        @(ord.Payment?.Status ?? "PAID")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
