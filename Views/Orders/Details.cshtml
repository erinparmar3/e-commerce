@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<a asp-action="Index" class="btn btn-link px-0">&larr; Back to orders</a>

<h2>Order #@Model.Id</h2>
<p class="text-muted">Placed @Model.OrderDate.ToLocalTime().ToString("f") &middot; Status: <span class="badge bg-info text-dark">@Model.Status</span></p>
<p><strong>Shipping to:</strong> @Model.ShippingAddress</p>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Unit Price</th>
            <th>Qty</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.ProductNameSnapshot</td>
                <td>@item.UnitPriceSnapshot.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>@item.LineTotal.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th>@Model.TotalAmount.ToString("C")</th>
        </tr>
    </tfoot>
</table>
