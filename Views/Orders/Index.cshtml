@model IEnumerable<OrderResponseDto>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-box-seam me-2 text-primary"></i>My Orders</h2>
            <p class="text-muted small m-0">Track shipments, manage active orders, and view past purchases</p>
        </div>
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Back to Shop
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="text-muted mb-3"><i class="bi bi-receipt display-1 text-secondary opacity-50"></i></div>
            <h4 class="fw-bold mb-2">No Orders Found</h4>
            <p class="text-muted mb-4">You haven't placed any orders yet. Discover trending products in our catalog.</p>
            <div>
                <a href="/" class="btn btn-primary-custom px-4 py-2">
                    <i class="bi bi-cart me-1"></i>Start Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <span class="small text-muted text-uppercase fw-semibold">Order Number</span>
                            <div class="fw-bold fs-5 text-dark">#@order.Id</div>
                            <div class="small text-muted">@order.CreatedAt.ToString("MMM dd, yyyy &bull; hh:mm tt")</div>
                        </div>

                        <div class="col-md-3">
                            <span class="small text-muted text-uppercase fw-semibold">Status & Payment</span>
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <span class="badge @(order.Status == OrderStatuses.Delivered ? "bg-success" : order.Status == OrderStatuses.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                    @order.Status
                                </span>
                                <span class="badge bg-light text-secondary border">
                                    @(order.Payment?.Status ?? "PAID")
                                </span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <span class="small text-muted text-uppercase fw-semibold">Total Amount</span>
                            <div class="fw-bold fs-5 text-primary">₹@order.TotalAmount.ToString("N2")</div>
                            <div class="small text-muted">@order.Items.Count() item(s) included</div>
                        </div>

                        <div class="col-md-3 text-md-end">
                            <a href="/orders/details/@order.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-medium">
                                <i class="bi bi-eye me-1"></i>View Details & Track
                            </a>
                        </div>
                    </div>

                    <!-- Items snapshot -->
                    <div class="mt-3 pt-3 border-top d-flex flex-wrap gap-2 align-items-center small text-muted">
                        <span class="fw-semibold text-secondary">Items:</span>
                        @foreach (var item in order.Items.Take(3))
                        {
                            <span class="badge bg-light text-dark border">
                                @item.Quantity &times; @item.ProductName
                            </span>
                        }
                        @if (order.Items.Count() > 3)
                        {
                            <span class="badge bg-light text-secondary">+@(order.Items.Count() - 3) more</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
