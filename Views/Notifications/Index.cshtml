@model IEnumerable<NotificationResponseDto>
@{
    ViewData["Title"] = "My Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-bell me-2 text-primary"></i>Notifications</h2>
            <p class="text-muted small m-0">Stay informed about order progress, vendor reviews, and account updates</p>
        </div>
        <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Back to Home
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
                <h5>No notifications right now</h5>
                <p class="small mb-0">You're all caught up! New updates regarding your orders will appear here.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <div class="list-group-item p-4 d-flex justify-content-between align-items-center @(n.IsRead ? "bg-white" : "bg-light bg-opacity-50")">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded-circle @(n.IsRead ? "bg-light text-muted" : "bg-primary text-white") mt-1">
                                <i class="bi @(n.IsRead ? "bi-check2" : "bi-bell-fill") fs-5"></i>
                            </div>
                            <div>
                                <div class="text-dark @(n.IsRead ? "" : "fw-bold") fs-6 mb-1">
                                    @n.Message
                                </div>
                                <div class="text-muted small">
                                    @n.CreatedAt.ToString("MMM dd, yyyy &bull; hh:mm tt")
                                    @if (!n.IsRead)
                                    {
                                        <span class="badge bg-primary-subtle text-primary ms-2">New</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="m-0 ms-3">
                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Mark as read">
                                    Mark as read
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
