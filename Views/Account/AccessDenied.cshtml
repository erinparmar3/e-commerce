@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-lock-fill display-1"></i>
                </div>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-muted mb-4">
                    You do not have the required role or permissions to access this portal. If you are a buyer looking to sell, you must register as a seller first.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-primary-custom px-4">
                        <i class="bi bi-house me-1"></i>Return Home
                    </a>
                    <a href="/account/login" class="btn btn-outline-secondary px-4">
                        Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
