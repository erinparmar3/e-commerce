@model UserProfileDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary text-white p-3 rounded-circle fs-3">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">@Model.Name</h4>
                            <span class="badge @(Model.Role == UserRoles.Admin ? "bg-danger" : Model.Role == UserRoles.Seller ? "bg-primary" : "bg-success") mt-1">
                                Role: @Model.Role
                            </span>
                        </div>
                    </div>
                    <div class="text-end text-muted small">
                        <div>Member Since</div>
                        <div class="fw-semibold">@Model.CreatedAt.ToString("MMM yyyy")</div>
                    </div>
                </div>

                <h5 class="fw-bold mb-3">Update Personal Details</h5>

                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Full Name</label>
                        <input type="text" name="Name" class="form-control" value="@Model.Name" required minlength="2" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Email Address (Read-only)</label>
                        <input type="email" class="form-control bg-light" value="@Model.Email" readonly disabled />
                        <div class="form-text small">Your registered email address cannot be changed.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted">Phone Number</label>
                        <input type="tel" name="Phone" class="form-control" value="@Model.Phone" placeholder="+91 98765 43210" />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/" class="btn btn-outline-secondary px-4">Back</a>
                        <button type="submit" class="btn btn-primary-custom px-4">
                            Save Changes
                        </button>
                    </div>
                </form>

                @if (Model.Role == UserRoles.Buyer)
                {
                    <div class="mt-5 p-4 rounded-4 bg-light border">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-shop text-primary me-2"></i>Want to sell products on ShopNet?</h6>
                                <p class="small text-muted mb-0">Apply as a vendor to list electronics, fashion, home goods, and more.</p>
                            </div>
                            <a href="/seller/apply" class="btn btn-primary btn-sm rounded-pill px-3">
                                Become a Seller
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
