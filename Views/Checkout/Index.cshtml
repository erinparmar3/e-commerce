@model CheckoutRequestDto
@{
    ViewData["Title"] = "Checkout";
    var cart = ViewBag.Cart as CartResponseDto ?? new CartResponseDto();
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold m-0"><i class="bi bi-shield-check me-2 text-primary"></i>Secure Checkout</h2>
        <p class="text-muted small m-0">Provide delivery details and choose your payment method</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2 small border-0 rounded-3 mb-4">
            @Html.ValidationSummary(false, "", new { @class = "m-0 list-unstyled" })
        </div>
    }

    <form asp-action="Process" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Address & Payment Details -->
            <div class="col-lg-7">
                <!-- Delivery Address Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                        <span>Shipping & Delivery Details</span>
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Recipient Full Name</label>
                            <input type="text" name="FullName" class="form-control" value="@Model.FullName" required minlength="2" maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Phone Number</label>
                            <input type="tel" name="Phone" class="form-control" value="@Model.Phone" placeholder="+91 98765 43210" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-muted">Street Address / House / Flat</label>
                            <input type="text" name="ShippingAddress" class="form-control" value="@Model.ShippingAddress" placeholder="e.g. 102 Crystal Towers, 5th Main" required minlength="5" maxlength="300" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">City</label>
                            <input type="text" name="City" class="form-control" value="@Model.City" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">State</label>
                            <input type="text" name="State" class="form-control" value="@Model.State" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Postal Code (PIN)</label>
                            <input type="text" name="PostalCode" class="form-control" value="@Model.PostalCode" required />
                        </div>
                    </div>
                </div>

                <!-- Payment Methods Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <span class="badge bg-primary rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                        <span>Select Payment Method</span>
                    </h5>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="form-check p-3 border rounded-3 bg-light">
                            <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="pay-card" value="CARD" checked>
                            <label class="form-check-label fw-bold d-flex align-items-center justify-content-between w-100" for="pay-card">
                                <span><i class="bi bi-credit-card-2-front text-primary me-2"></i>Credit / Debit Card</span>
                                <span class="badge bg-white text-muted border">Visa / Mastercard / RuPay</span>
                            </label>
                            <div class="row g-2 mt-2 pt-2 border-top">
                                <div class="col-12">
                                    <input type="text" class="form-control form-control-sm" placeholder="Card Number: 4532 •••• •••• 8892" value="4532 9988 7766 8892" />
                                </div>
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm" placeholder="MM/YY" value="12/28" />
                                </div>
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm" placeholder="CVV" value="842" />
                                </div>
                            </div>
                        </div>

                        <div class="form-check p-3 border rounded-3">
                            <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="pay-upi" value="UPI">
                            <label class="form-check-label fw-bold d-flex align-items-center justify-content-between w-100" for="pay-upi">
                                <span><i class="bi bi-qr-code text-success me-2"></i>Instant UPI / QR Code</span>
                                <span class="badge bg-light text-muted border">GPay / PhonePe / Paytm</span>
                            </label>
                        </div>

                        <div class="form-check p-3 border rounded-3">
                            <input class="form-check-input ms-0 me-3" type="radio" name="PaymentMethod" id="pay-netbank" value="NETBANKING">
                            <label class="form-check-label fw-bold" for="pay-netbank">
                                <i class="bi bi-bank text-info me-2"></i>Net Banking (All Major Indian Banks)
                            </label>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 small text-muted border d-flex align-items-center gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <span><strong>100% Safe & Secure:</strong> All transactions are protected with 256-bit bank-grade encryption and ShopNet Buyer Protection.</span>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items & Place Order Summary -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
                    <h5 class="fw-bold mb-3 pb-2 border-bottom">Review Items (@cart.Items.Count())</h5>

                    <div class="d-flex flex-column gap-3 mb-4 overflow-y-auto" style="max-height: 280px;">
                        @foreach (var item in cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width: 44px; height: 44px; border-radius: 6px; overflow: hidden; background: #f1f5f9; flex-shrink: 0;" class="border">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='/images/placeholder.png';" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small"><i class="bi bi-image"></i></div>
                                        }
                                    </div>
                                    <div>
                                        <div class="small fw-semibold text-truncate" style="max-width: 180px;">@item.ProductName</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">Qty: @item.Quantity &times; ₹@item.Price.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="fw-bold small text-nowrap">
                                    ₹@item.Subtotal.ToString("N2")
                                </div>
                            </div>
                        }
                    </div>

                    <hr class="my-3 opacity-25" />

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Subtotal</span>
                        <span class="fw-semibold">₹@cart.Subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Tax (10%)</span>
                        <span class="fw-semibold">₹@cart.Tax.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted small">Standard Shipping</span>
                        <span class="fw-semibold text-success">FREE</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4 pt-2 border-top">
                        <span class="fs-5 fw-bold text-dark">Grand Total</span>
                        <span class="fs-4 fw-bold text-primary">₹@cart.Total.ToString("N2")</span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-custom py-2 fs-6">
                            <i class="bi bi-lock-fill me-1"></i>Pay ₹@cart.Total.ToString("N2") & Place Order
                        </button>
                    </div>

                    <div class="text-center mt-3 text-muted" style="font-size: 0.75rem;">
                        <i class="bi bi-shield-check text-success me-1"></i>By clicking "Place Order", you agree to ShopNet's Terms of Service and Return Policy.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
