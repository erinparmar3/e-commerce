@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Multi-Vendor Marketplace") - ShopNet</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5.3.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Modern Commercial E-Commerce Theme -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- 1. Real Customer Utility & Announcement Bar -->
    <div class="top-announcement-bar">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-sm-inline"><i class="bi bi-truck text-primary me-1"></i>Free Express Shipping on orders over ₹499</span>
                <span><i class="bi bi-patch-check text-success me-1"></i>100% Authentic Products</span>
                <span class="d-none d-md-inline"><i class="bi bi-arrow-repeat text-info me-1"></i>7-Day Easy Returns</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-lg-inline"><i class="bi bi-headset me-1 text-warning"></i>Customer Support: 1800-SHOPNET</span>
                @if (!User.Identity?.IsAuthenticated == true || !User.IsInRole(UserRoles.Seller))
                {
                    <a href="/seller/apply" class="announcement-link"><i class="bi bi-shop me-1 text-warning"></i>Sell on ShopNet</a>
                }
            </div>
        </div>
    </div>

    <!-- 2. Main Navigation Bar -->
    <header class="navbar-marketplace">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between gap-3 w-100 flex-wrap flex-md-nowrap">
                <!-- ShopNet Brand Logo -->
                <a class="navbar-brand text-decoration-none" href="/">
                    <div class="brand-icon-box">
                        <i class="bi bi-bag-check-fill"></i>
                    </div>
                    <span class="brand-title">Shop<span class="brand-title-accent">Net</span></span>
                </a>

                <!-- Central Search Bar -->
                <div class="flex-grow-1 mx-md-4 my-2 my-md-0" style="max-width: 620px;">
                    <form action="/" method="get" class="search-bar-wrap">
                        <i class="bi bi-search search-icon"></i>
                        <input type="search" name="search" class="form-control" placeholder="Search for electronics, fashion, home essentials & more..." value="@Context.Request.Query["search"]" autocomplete="off" />
                        <button type="submit" class="search-submit-btn">Search</button>
                    </form>
                </div>

                <!-- Right Navigation Controls -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Admin))
                        {
                            <a href="/admin/dashboard" class="header-action-btn header-btn-admin">
                                <i class="bi bi-speedometer2"></i>
                                <span class="d-none d-lg-inline">Admin Panel</span>
                            </a>
                        }
                        @if (User.IsInRole(UserRoles.Seller))
                        {
                            <a href="/seller/dashboard" class="header-action-btn header-btn-seller">
                                <i class="bi bi-shop"></i>
                                <span class="d-none d-lg-inline">Seller Portal</span>
                            </a>
                        }
                        else if (!User.IsInRole(UserRoles.Admin))
                        {
                            <a href="/seller/apply" class="header-action-btn text-warning d-none d-sm-flex">
                                <i class="bi bi-award"></i>
                                <span class="d-none d-lg-inline">Become a Seller</span>
                            </a>
                        }

                        <!-- Wishlist Link -->
                        <a href="/wishlist" class="header-action-btn" title="Saved Wishlist">
                            <i class="bi bi-heart fs-5"></i>
                            <span class="d-none d-xl-inline">Wishlist</span>
                        </a>

                        <!-- Shopping Cart Link -->
                        <a href="/cart" class="header-action-btn" title="Shopping Cart">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span class="d-none d-xl-inline">Cart</span>
                        </a>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button class="header-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="d-none d-sm-inline">@User.Identity.Name</span>
                                <span class="badge @(User.IsInRole(UserRoles.Admin) ? "bg-danger" : User.IsInRole(UserRoles.Seller) ? "bg-primary" : "bg-success") ms-1 small">
                                    @User.FindFirst(ClaimTypes.Role)?.Value
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-bold">@User.Identity.Name</div>
                                    <div class="small text-muted">@User.FindFirst(ClaimTypes.Email)?.Value</div>
                                </li>
                                <li><a class="dropdown-item py-2" href="/account/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item py-2" href="/orders"><i class="bi bi-box-seam me-2"></i>My Orders</a></li>
                                <li><a class="dropdown-item py-2" href="/notifications"><i class="bi bi-bell me-2"></i>Notifications</a></li>
                                @if (User.IsInRole(UserRoles.Seller))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-primary" href="/seller/dashboard"><i class="bi bi-shop me-2"></i>Seller Dashboard</a></li>
                                    <li><a class="dropdown-item py-2 text-primary" href="/seller/products/new"><i class="bi bi-plus-circle me-2"></i>Add New Product</a></li>
                                }
                                @if (User.IsInRole(UserRoles.Admin))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="/admin/sellers"><i class="bi bi-person-check me-2"></i>Vendor Approvals</a></li>
                                    <li><a class="dropdown-item py-2 text-danger" href="/admin/categories"><i class="bi bi-tags me-2"></i>Product Categories</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill"><i class="bi bi-box-arrow-right me-1"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Guest State -->
                        <a href="/seller/apply" class="header-action-btn text-warning d-none d-md-flex">
                            <i class="bi bi-award"></i>
                            <span>Sell with Us</span>
                        </a>
                        <a href="/account/login" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-medium">Sign In</a>
                        <a href="/account/register" class="btn btn-primary btn-sm rounded-pill px-3 fw-medium">Register</a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- 3. Category Subnavigation Bar -->
    <nav class="category-subnav d-none d-md-block">
        <div class="container d-flex align-items-center gap-2 overflow-x-auto py-1">
            <span class="text-muted small fw-bold me-2"><i class="bi bi-grid-fill me-1"></i>Departments:</span>
            <a href="/" class="category-pill @(string.IsNullOrEmpty(Context.Request.Query["categoryId"]) ? "active" : "")">All Departments</a>
            <a href="/?categoryId=1" class="category-pill @(Context.Request.Query["categoryId"] == "1" ? "active" : "")"><i class="bi bi-laptop me-1"></i>Electronics & Gadgets</a>
            <a href="/?categoryId=2" class="category-pill @(Context.Request.Query["categoryId"] == "2" ? "active" : "")"><i class="bi bi-tag me-1"></i>Fashion & Apparel</a>
            <a href="/?categoryId=3" class="category-pill @(Context.Request.Query["categoryId"] == "3" ? "active" : "")"><i class="bi bi-house-door me-1"></i>Home & Kitchen</a>
            <a href="/?categoryId=4" class="category-pill @(Context.Request.Query["categoryId"] == "4" ? "active" : "")"><i class="bi bi-book me-1"></i>Books & Stationery</a>
            <a href="/?categoryId=5" class="category-pill @(Context.Request.Query["categoryId"] == "5" ? "active" : "")"><i class="bi bi-bicycle me-1"></i>Sports & Fitness</a>
        </div>
    </nav>

    <!-- 4. Flash Notifications / Alerts -->
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div class="flex-grow-1">@TempData["Success"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-5 me-2 text-danger"></i>
                <div class="flex-grow-1">@TempData["Error"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
                <div class="flex-grow-1">@TempData["Info"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- 5. Main Content -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- 6. Modern Customer-Centric Footer -->
    <footer class="footer-marketplace">
        <div class="container">
            <!-- Trust Features Bar -->
            <div class="row g-4 py-4 mb-5 border-bottom border-secondary border-opacity-25">
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="footer-feature-icon">
                            <i class="bi bi-truck text-primary fs-3"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white small">Free Express Delivery</div>
                            <div class="text-muted" style="font-size: 0.75rem;">On all eligible orders over ₹499</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="footer-feature-icon">
                            <i class="bi bi-shield-check text-success fs-3"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white small">100% Genuine Products</div>
                            <div class="text-muted" style="font-size: 0.75rem;">From verified marketplace merchants</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="footer-feature-icon">
                            <i class="bi bi-credit-card-2-front text-info fs-3"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white small">Secure Encrypted Payments</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Credit/Debit Cards, UPI & Net Banking</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="footer-feature-icon">
                            <i class="bi bi-arrow-repeat text-warning fs-3"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-white small">7-Day Replacement Policy</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Hassle-free support & assistance</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Navigation Columns -->
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-box">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <span class="fs-4 fw-bold text-white">Shop<span class="text-primary">Net</span></span>
                    </div>
                    <p class="text-muted small pe-lg-4 leading-relaxed">
                        ShopNet is India's premier multi-vendor marketplace connecting verified independent merchants, artisan brands, and electronics retailers directly with discerning buyers nationwide.
                    </p>
                    <div class="d-flex gap-3 text-secondary fs-5 mt-3">
                        <a href="#" class="social-link" title="Twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="social-link" title="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Shop by Category</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/?categoryId=1">Electronics & Gadgets</a></li>
                        <li><a href="/?categoryId=2">Fashion & Apparel</a></li>
                        <li><a href="/?categoryId=3">Home & Kitchen</a></li>
                        <li><a href="/?categoryId=4">Books & Stationery</a></li>
                        <li><a href="/?categoryId=5">Sports & Fitness</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Merchant Hub</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/seller/apply">Sell on ShopNet</a></li>
                        <li><a href="/seller/dashboard">Seller Portal</a></li>
                        <li><a href="/seller/products/new">List New Product</a></li>
                        <li><a href="/account/profile">Account Settings</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h5>Customer Assistance</h5>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="/orders"><i class="bi bi-truck me-2 text-primary"></i>Track Your Order</a></li>
                        <li><a href="/wishlist"><i class="bi bi-heart me-2 text-danger"></i>Saved Wishlist</a></li>
                        <li><a href="/notifications"><i class="bi bi-bell me-2 text-warning"></i>Order Updates & Notifications</a></li>
                        <li><span class="text-secondary"><i class="bi bi-envelope me-2 text-info"></i>support@shopnet.in</span></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary opacity-25 my-4" />

            <div class="d-flex flex-wrap justify-content-between align-items-center small text-muted">
                <div>
                    &copy; @DateTime.UtcNow.Year ShopNet Marketplace. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a href="/">Privacy Policy</a>
                    <span>&bull;</span>
                    <a href="/">Terms of Service</a>
                    <span>&bull;</span>
                    <a href="/">Merchant Agreement</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Interactive Enhancements (Smooth Wishlist Toggle) -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.wishlist-toggle-form').forEach(form => {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const btn = form.querySelector('button');
                    const icon = btn ? btn.querySelector('i') : null;

                    try {
                        const formData = new FormData(form);
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Accept': 'application/json'
                            }
                        });

                        if (response.status === 401) {
                            const data = await response.json();
                            window.location.href = data.redirectUrl || '/account/login';
                            return;
                        }

                        if (response.ok) {
                            const data = await response.json();
                            if (data.inWishlist) {
                                btn.classList.add('active', 'text-danger');
                                if (icon) {
                                    icon.classList.remove('bi-heart');
                                    icon.classList.add('bi-heart-fill', 'text-danger');
                                }
                            } else {
                                btn.classList.remove('active', 'text-danger');
                                if (icon) {
                                    icon.classList.remove('bi-heart-fill', 'text-danger');
                                    icon.classList.add('bi-heart');
                                }
                            }
                        } else {
                            form.submit();
                        }
                    } catch (err) {
                        form.submit();
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
